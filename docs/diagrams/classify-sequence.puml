@startuml
skinparam backgroundColor white
skinparam participant {
  BackgroundColor #f8fafc
  BorderColor #64748b
}

title Classification Sequence

actor "User" as user
participant "Browser\n(SPA)" as spa
participant "FastAPI\nBackend" as api
participant "Model\nCache (LRU)" as cache
participant "HF Hub\nWeights" as hf

user -> spa : upload orchid photo
spa -> api : POST /classify/upload\n+ image file
activate api

alt model not in cache
  api -> hf : download .pt weights
  activate hf
  hf --> api : weights file
  deactivate hf
  api -> cache : load model
else model cached
  api -> cache : get from LRU
end

api -> api : forward pass\n+ softmax
api --> spa : top-6 predictions\n+ confidence
deactivate api

spa --> user : show results card\n+ species + %

@enduml
