@startuml
skinparam backgroundColor white
skinparam componentStyle rectangle

title System Architecture — OrchID OSR

actor "User / Browser" as user

package "Cloudflare" {
  component "Cloudflare Tunnel\n(edge)" as tunnel
}

package "VPS" {
  component "Nginx\n(frontend SPA + proxy)" as nginx
  component "FastAPI Backend" as api
  component "Classifier\nModel" as model
  database "HF Hub\nModel Weights" as hf_models
  database "HF Hub\nDataset Images" as hf_data
  database "Local Volume\n/data (persist)" as cache
}

user --> tunnel : HTTPS\norchid-osr.klad.ml
tunnel --> nginx : HTTP (internal docker network)

nginx --> api : proxy /api/* /auth/* /health
nginx --> nginx : serve SPA\n(frontend/dist)

api --> model : load & predict
model --> hf_models : download .pt\n(on demand)
api --> hf_data : proxy images
api --> cache : read/write\nusers.json\nexperiments

@enduml
