@startuml
skinparam backgroundColor #FFFFFF
skinparam rectangle {
  BackgroundColor #E3F2FD
  BorderColor #0173B2
  RoundCorner 12
  FontName Inter
  FontSize 13
}
skinparam arrow {
  Color #333333
  Thickness 1.5
}
rectangle "Input\n256×512 / 224×224" as Input
rectangle "Backbone\nResNet / ConvNeXt / DINOv2" as Backbone
rectangle "SpHOR\nSpherical Prototypes" as Sphor
rectangle "Classifier\nMLP Head" as Head
Input --> Backbone
Backbone --> Sphor
Sphor --> Head
@enduml
