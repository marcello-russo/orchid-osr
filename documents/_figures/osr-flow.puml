@startuml
skinparam backgroundColor #FFFFFF
skinparam rectangle {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  RoundCorner 12
  FontName Inter
}
skinparam arrow {
  Color #333333
  Thickness 1.5
}
rectangle "Train\n(known)" as Train
rectangle "Embedding" as Embedding
rectangle "Detector\nMahalanobis / KNN\nEnergy (+ Ensemble)" as Detector
rectangle "Novel detection" as Novel
Train --> Embedding
Embedding --> Detector
Detector --> Novel
@enduml
