# HuggingFace token (necessario per scaricare dataset, modelli, e sincronizzare risultati)
# Ottieni il token su https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_HF_TOKEN_HERE

# Chiave segreta per firmare i JWT di autenticazione
# DEVE essere una stringa casuale lunga e complessa (minimo 32 caratteri)
# Se vuota, il server non parte
JWT_SECRET=***RIMOSSO***

# Credenziali admin per l'autenticazione
# (opzionale — default: marcello/orchid-2026 se non impostato)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=***RIMOSSO***
