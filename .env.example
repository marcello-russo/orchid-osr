# OrchID OSR — variabili non segrete (layout /srv/orchid: .env)
# I segreti veri stanno in secrets/app.env (600), mai qui.
# In locale questo file si copia in .env e si aggiungono i segreti.

# Immagine pubblicata dal dispatcher su tag v* (mai `latest`).
ORCHID_VERSION=v0.2.0

# Porta di loopback su cui il tunnel raggiunge l'app (blocco 8000-8099, tabella host-layout).
ORCHID_PORT=8000

# Config applicativa
COMPOSE_PROJECT_NAME=orchid
HF_DATASET_REPO=marcellorusso/orchid-osr-dataset
HF_MODELS_REPO=marcellorusso/orchid-osr-models

# Segreti — in produzione finiscono in secrets/app.env, non qui.
# HF_TOKEN=hf_...
# JWT_SECRET=...
# SUPERADMIN_USERNAME=...
# SUPERADMIN_PASSWORD=...
